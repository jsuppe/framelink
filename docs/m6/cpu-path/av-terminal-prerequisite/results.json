      "shell",
      "ps -A -o PID,ARGS"
    ],
    "exit": 0
  },
  {
    "step": "mkdir",
    "command": [
      "<linux-home>/Android/Sdk/platform-tools/adb",
      "-s",
      "A06B4AABFB07983",
      "shell",
      "mkdir -p /data/local/tmp/framelink-av-terminal"
    ],
    "exit": 0
  },
  {
    "step": "push-fl_gst_session_context",
    "command": [
      "<linux-home>/Android/Sdk/platform-tools/adb",
      "-s",
      "A06B4AABFB07983",
      "push",
      "<linux-home>/dev/build/framelink-m6-arm64/fl_gst_session_context",
      "/data/local/tmp/framelink-av-terminal/"
    ],
    "exit": 0
  },
  {
    "step": "push-fl_gst_shared_cpu_events",

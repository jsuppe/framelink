[
  {
    "step": "build-linux",
    "command": [
      "cmake",
      "--build",
      "<linux-home>/dev/build/framelink-m6-linux",
      "-j4",
      "--target",
      "fl_gst_session_context",
      "fl_gst_shared_cpu_events",
      "fl_gst_shared_cpu_roundtrip"
    ],
    "exit": 0
  },
  {
    "step": "linux",
    "command": [
      "ctest",
      "--test-dir",
      "<linux-home>/dev/build/framelink-m6-linux",
      "-R",
      "^(gst_session_context|gst_shared_cpu_events|gst_shared_cpu_roundtrip)$",
      "--output-on-failure"
    ],
    "exit": 0
  },
  {
    "step": "build-arm64",
    "command": [
      "cmake",
      "--build",
      "<linux-home>/dev/build/framelink-m6-arm64",
      "-j4",
      "--target",
      "fl_gst_session_context",
      "fl_gst_shared_cpu_events",
      "fl_gst_shared_cpu_roundtrip"
    ],
    "exit": 0
  },
  {
    "step": "build-x86_64",
    "command": [
      "cmake",
      "--build",
      "<linux-home>/dev/build/framelink-m6-x86_64",
      "-j4",
      "--target",
      "fl_gst_session_context",
      "fl_gst_shared_cpu_events",
      "fl_gst_shared_cpu_roundtrip"
    ],
    "exit": 0
  },
  {
    "step": "device-process",
    "command": [
      "<linux-home>/Android/Sdk/platform-tools/adb",

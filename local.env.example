# Machine-local values. Copy to local.env (gitignored) and edit, or run
#   python3 tools/setup_local_env.py
# The localenv git filter replaces these with placeholders in commits and
# restores them on checkout. Leave a key empty to disable that substitution.
FL_LINUX_HOME=/home/you
FL_LINUX_HOST=linux-box
FL_WIN_HOME=C:\Users\you
FL_WIN_USER=you
FL_WIN_HOST=windows-box

Element Properties:

  async               : Go asynchronously to PAUSED
                        flags: readable, writable
                        Boolean. Default: true
  
  blocksize           : Size in bytes to pull per buffer (0 = default)
                        flags: readable, writable
                        Unsigned Integer. Range: 0 - 4294967295 Default: 4096 
  
  buffer-wait-ms      : Maximum wait for a reusable image; zero is nonblocking, not an added presentation delay
                        flags: readable, writable, changeable only in NULL or READY state
                        Unsigned Integer. Range: 0 - 1000 Default: 5 
  
  channel             : framelink channel name (or slot-set prefix when slots > 0)
                        flags: readable, writable
                        String. Default: "framelink"
  
  connect-timeout-ms  : Open the producer before streaming; 0 keeps lazy connection
                        flags: readable, writable, changeable only in NULL or READY state
                        Unsigned Integer. Range: 0 - 60000 Default: 0 
  
  enable-last-sample  : Enable the last-sample property
                        flags: readable, writable
                        Boolean. Default: true
  
  error-on-ring-full  : Raise an error instead of dropping when the bounded buffer wait expires
                        flags: readable, writable, changeable only in NULL or READY state
                        Boolean. Default: false
  
  last-sample         : The last sample received in the sink
                        flags: readable
                        Boxed pointer of type "GstSample"
  
  max-bitrate         : The maximum bits per second to render (0 = disabled)
                        flags: readable, writable
                        Unsigned Integer64. Range: 0 - 18446744073709551615 Default: 0 
  
  max-lateness        : Maximum number of nanoseconds that a buffer can be late before it is dropped (-1 unlimited)
                        flags: readable, writable
                        Integer64. Range: -1 - 9223372036854775807 Default: -1 
  
  name                : The name of the object
                        flags: readable, writable
                        String. Default: "framelinksink0"
  
  native-memory       : Strict native buffers acquired from this sink; no implicit copy fallback
                        flags: readable, writable, changeable only in NULL or READY state
                        Boolean. Default: false
  
  parent              : The parent of the object
                        flags: readable, writable
                        Object of type "GstObject"
  
  preserve-frame-metadata: Require exact running-time PTS/DTS/duration and media generation; both endpoints must opt in
                        flags: readable, writable, changeable only in NULL or READY state
                        Boolean. Default: false
  
  preserve-timestamps : Opt-in agreed session running-time PTS; both pipelines must share clock and base time
                        flags: readable, writable, changeable only in NULL or READY state
                        Boolean. Default: false
  
  processing-deadline : Maximum processing time for a buffer in nanoseconds
                        flags: readable, writable
                        Unsigned Integer64. Range: 0 - 18446744073709551615 Default: 20000000 
  
  qos                 : Generate Quality-of-Service events upstream
                        flags: readable, writable
                        Boolean. Default: false
  
  render-delay        : Additional render delay of the sink in nanoseconds
                        flags: readable, writable
                        Unsigned Integer64. Range: 0 - 18446744073709551615 Default: 0 
  
  shared-cpu          : Explicit broker-bound CPU copy-in with bounded ownership wait; COPY required; A/V requires event stream
                        flags: readable, writable
                        Boolean. Default: false
  
  slots               : walk consumer slot channels <channel>.0..N-1 and take the first free one (0 = open <channel> directly)
                        flags: readable, writable
                        Integer. Range: 0 - 64 Default: 0 
  
  stats               : Sink Statistics
                        flags: readable
                        Boxed pointer of type "GstStructure"
                                                        average-rate: 0 (gdouble)
                                                             dropped: 0 (guint64)
                                                            rendered: 0 (guint64)

  
  sync                : Sync on the clock
                        flags: readable, writable
                        Boolean. Default: false
  
  throttle-time       : The time to keep between rendered buffers (0 = disabled)
                        flags: readable, writable
                        Unsigned Integer64. Range: 0 - 18446744073709551615 Default: 0 
  
  ts-offset           : Timestamp offset in nanoseconds
                        flags: readable, writable
                        Integer64. Range: -9223372036854775808 - 9223372036854775807 Default: 0 
  

Element Actions:

  "apply-memory-policy" -> gboolean  :  g_signal_emit_by_name (element, "apply-memory-policy",
                                                               gpointer arg0,
                                                               gboolean * p_return_value);

  "adopt-channel" -> gboolean  :  g_signal_emit_by_name (element, "adopt-channel",
                                                         gpointer arg0,
                                                         gboolean * p_return_value);

  "set-native-ready-fd" -> gboolean  :  g_signal_emit_by_name (element, "set-native-ready-fd",
                                                               gpointer arg0,
                                                               gint arg1,
                                                               gboolean * p_return_value);

  "acquire-native-buffer" -> gpointer  :  g_signal_emit_by_name (element, "acquire-native-buffer",
                                                                 guint arg0,
                                                                 gpointer * p_return_value);

